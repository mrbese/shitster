{
  "name": "dashoff-counter",
  "main": "counter.js",
  "compatibility_date": "2026-07-01",
  "routes": [
    { "pattern": "dashoff.org/api/counter", "zone_name": "dashoff.org" }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COUNTER_DO",
        "class_name": "Counter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Counter"]
    }
  ],
  "vars": {
    "SITE_ORIGIN": "https://dashoff.org",
    "GOAL": "5000"
  }
}
